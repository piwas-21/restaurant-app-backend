# Root editorconfig for the backend (DEV-PHASES W1).
#
# Scope: analyzer severity configuration ONLY.
# Deliberately does NOT set whitespace / code-style conventions — those are
# owned by `dotnet format` defaults (CI job: dotnet format --verify-no-changes
# --severity warn), and adding conventions here would fight that gate.

root = true

# ---------------------------------------------------------------------------
# W1 baseline — ratchet: promote back to warning as violations get fixed.
#
# Rules below fired on the pre-existing codebase when analyzers were first
# enabled (AnalysisMode Recommended + Meziantou.Analyzer, 2026-07-07).
# They are downgraded to `suggestion` so the strict build (warnings-as-errors)
# stays green without hiding them from the IDE. Violation counts at baseline
# time are noted per rule (whole solution incl. tests; migrations excluded).
# When a rule's count reaches zero, DELETE its line here — it then enforces
# at warning = error.
# ---------------------------------------------------------------------------
[*.cs]
dotnet_diagnostic.CA1000.severity = suggestion  #   5 — no static members on generic types
dotnet_diagnostic.CA1001.severity = suggestion  #   1 — types owning disposable fields should be disposable
dotnet_diagnostic.CA1051.severity = suggestion  #   3 — do not declare visible instance fields
dotnet_diagnostic.CA1304.severity = suggestion  #  26 — specify CultureInfo
dotnet_diagnostic.CA1305.severity = suggestion  #  29 — specify IFormatProvider
dotnet_diagnostic.CA1311.severity = suggestion  #  26 — specify culture or use invariant To{Upper,Lower}
dotnet_diagnostic.CA1710.severity = suggestion  #   1 — identifiers should have correct suffix
dotnet_diagnostic.CA1711.severity = suggestion  #   3 — identifiers should not have incorrect suffix
dotnet_diagnostic.CA1716.severity = suggestion  #   2 — identifiers should not match keywords
dotnet_diagnostic.CA1822.severity = suggestion  #  12 — mark members as static
dotnet_diagnostic.CA1845.severity = suggestion  #   1 — use span-based string.Concat
dotnet_diagnostic.CA1848.severity = suggestion  # 378 — use LoggerMessage delegates
dotnet_diagnostic.CA1860.severity = suggestion  #  35 — prefer Count/Length == 0 over Any()
dotnet_diagnostic.CA1861.severity = suggestion  #  19 — avoid constant arrays as arguments (tests)
dotnet_diagnostic.CA1862.severity = suggestion  #  12 — use StringComparison for case-insensitive compares
dotnet_diagnostic.CA1869.severity = suggestion  #   9 — cache and reuse JsonSerializerOptions
dotnet_diagnostic.CA1873.severity = suggestion  #   8 — guard expensive log-arg evaluation (seeders; surfaces only on the CI SDK, newer than local 10.0.101 — no global.json pin)
dotnet_diagnostic.CA2016.severity = suggestion  #   2 — forward the CancellationToken
dotnet_diagnostic.CA2201.severity = suggestion  #   4 — do not raise reserved exception types
dotnet_diagnostic.CA2254.severity = suggestion  #  35 — logging message template should be constant
dotnet_diagnostic.MA0002.severity = suggestion  #  81 — IEqualityComparer/IComparer is missing
dotnet_diagnostic.MA0004.severity = suggestion  # 728 — use Task.ConfigureAwait
dotnet_diagnostic.MA0006.severity = suggestion  #  27 — use string.Equals instead of ==
dotnet_diagnostic.MA0009.severity = suggestion  #   7 — add regex evaluation timeout
dotnet_diagnostic.MA0011.severity = suggestion  #  57 — IFormatProvider is missing
dotnet_diagnostic.MA0015.severity = suggestion  #   4 — specify parameter name in ArgumentException
dotnet_diagnostic.MA0016.severity = suggestion  # 168 — prefer collection abstraction over implementation
dotnet_diagnostic.MA0022.severity = suggestion  #   1 — return Task.FromResult instead of null
dotnet_diagnostic.MA0023.severity = suggestion  #   1 — add RegexOptions.ExplicitCapture
dotnet_diagnostic.MA0025.severity = suggestion  #   1 — implement the functionality (TODO throw)
dotnet_diagnostic.MA0026.severity = suggestion  #  12 — fix TODO comments
dotnet_diagnostic.MA0048.severity = suggestion  # 185 — file name must match type name
dotnet_diagnostic.MA0049.severity = suggestion  #  99 — type name should not match containing namespace (default: error)
dotnet_diagnostic.MA0051.severity = suggestion  #  91 — method is too long
dotnet_diagnostic.MA0074.severity = suggestion  #   2 — avoid implicit culture-sensitive methods
dotnet_diagnostic.MA0140.severity = suggestion  #   1 — both if and else branch have identical code

# ---------------------------------------------------------------------------
# Integration tests: permanent exemptions (NOT ratchet items).
# CA1707: underscore-separated test method names (Given_When_Then style) are
# the xUnit convention this suite deliberately uses (122 methods).
# ---------------------------------------------------------------------------
[RestaurantSystem.IntegrationTests/**.cs]
dotnet_diagnostic.CA1707.severity = none

# ---------------------------------------------------------------------------
# EF Core migrations + model snapshot: auto-generated (~139k LOC).
# Immutable once applied (CLAUDE.md §9) — keep them out of analysis entirely.
# NOTE: rule-specific severities above take precedence over the bulk `none`
# below, but generated_code = true keeps analyzers out of these files anyway.
# ---------------------------------------------------------------------------
[**/Migrations/*.cs]
generated_code = true
dotnet_analyzer_diagnostic.severity = none
