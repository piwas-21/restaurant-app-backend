<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.7.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.10" />
    <PackageReference Include="Testcontainers.PostgreSql" Version="4.13.0" />
    <!-- Testcontainers' SSH transport is unused here; pin its transitive dependency to the patched release. -->
    <PackageReference Include="SSH.NET" Version="2026.0.0" />
    <ProjectReference Include="../RestaurantSystem.Channels.Api/RestaurantSystem.Channels.Api.csproj" />
    <Using Include="Xunit" />
    <Content Include="Fixtures/uber-order-simple.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Fixtures/uber-sandbox-menu-readback.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../RestaurantSystem.Channels.Infrastructure/Migrations/001_webhook_inbox.sql"
             Link="001_webhook_inbox.sql" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../RestaurantSystem.Channels.Infrastructure/Migrations/002_sandbox_console.sql"
             Link="002_sandbox_console.sql" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../RestaurantSystem.Channels.Infrastructure/Migrations/003_tenant_import_jobs.sql"
             Link="003_tenant_import_jobs.sql" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
