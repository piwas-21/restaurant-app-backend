<Project>

  <!--
    Backend Sprint 3 quality gate: warnings-as-errors.

    All compiler (CSxxxx), analyzer (CAxxxx), and code-style (IDExxxx)
    warnings fail the build. Forces real fixes instead of accumulating
    silent warnings.

    Permanent exclusions (never blocking, no follow-up):
    - NU1901..NU1904: NuGet package vulnerability advisories. These can
      surface without any code change (a transitive dep gains a CVE
      overnight) and are the responsibility of the dep-upgrade track,
      not of the MR that happens to be open at the time. Tracked
      separately under docs/QUALITY-SECURITY-PLAN.md.
    - CS8981: "type name only contains lower-case ASCII chars". Fires
      on EF Core's auto-generated migration class names (e.g.
      'productsides', 'special'). Migrations are immutable once
      applied to staging/prod (CLAUDE.md §9), so renaming is not an
      option. The warning surfaces nothing actionable here.

    No transitional exclusions remaining as of Sprint 3 cleanup.
  -->
  <PropertyGroup>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsNotAsErrors>
      NU1901;NU1902;NU1903;NU1904;
      CS8981
    </WarningsNotAsErrors>
  </PropertyGroup>

  <!--
    DEV-PHASES W1: Roslyn analyzers.

    - AnalysisLevel latest + AnalysisMode Recommended dials the built-in
      .NET SDK analyzers (CAxxxx) up from the minimal default set.
    - Meziantou.Analyzer adds MAxxxx rules (async/culture/perf correctness).
    - SonarAnalyzer.CSharp is deliberately NOT added: SonarCloud automatic
      analysis already runs those rules server-side; a local copy would
      duplicate findings and double build cost.
    - EnforceCodeStyleInBuild stays off: IDExxxx style rules are owned by
      the `dotnet format` CI job, not the compiler.

    Pre-existing violations are baselined in the root .editorconfig as
    suggestion-severity rules (ratchet: promote back to warning as their
    violation counts reach zero). EF migrations are excluded there as
    generated code.
  -->
  <PropertyGroup>
    <AnalysisLevel>latest</AnalysisLevel>
    <AnalysisMode>Recommended</AnalysisMode>
  </PropertyGroup>

  <ItemGroup Condition="'$(MSBuildProjectExtension)' == '.csproj'">
    <PackageReference Include="Meziantou.Analyzer" Version="3.0.121" PrivateAssets="all" IncludeAssets="runtime; build; native; contentfiles; analyzers" />
  </ItemGroup>

</Project>
